# Tunner local Docker development defaults. Exact version tags are refreshed through
# governed R&D; do not use latest or edge tags. This file contains no credentials.
COMPOSE_PROJECT_NAME=tunner-local
POSTGRES_IMAGE=postgres:18.6
RABBITMQ_IMAGE=rabbitmq:4.3.6-management
REDIS_IMAGE=redis:8.10.2
OPENBAO_IMAGE=openbao/openbao:2.7.0
MAILPIT_IMAGE=axllent/mailpit:v1.31.3
OTEL_LGTM_IMAGE=grafana/otel-lgtm:0.34.0
PLACEHOLDER_IMAGE=busybox:1.37.0

# Loopback-only host ports. Override in an ignored .env.local file when a local
# port conflict exists. Do not put credentials, API keys, or OpenBao tokens here.
POSTGRES_PORT=5432
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
OPENBAO_PORT=8200
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
GRAFANA_PORT=3000
