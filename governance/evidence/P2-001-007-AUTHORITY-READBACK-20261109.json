          {
            "kind": "shape-with-text",
            "id": "78:5435",
            "text": "Tunner registration does not grant Product-specific entitlements or roles"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5438",
            "text": "Existing Account detection must not leak whether arbitrary third-party contact values exist"
