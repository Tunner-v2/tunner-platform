      {
        "id": "88:6717",
        "name": "37 — Identity — Registration, Verified Contact &amp; Account Activation",
        "nodes": [
          {
            "kind": "shape-with-text",
            "id": "78:5357",
            "text": "Registration request"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5360",
            "text": "Origin?"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5363",
            "text": "Tunner registration context"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5366",
            "text": "Preserve Product authorization context\nproduct_id · client_id · registered redirect_uri · state · PKCE · requested scopes"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5369",
            "text": "Collect minimum Account registration fields\nNo DOB / no 18+ gate"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5372",
            "text": "Normalize identifier/contact and evaluate duplicate/existing Account"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5375",
            "text": "Existing Tunner Account?"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5378",
            "text": "Do not create duplicate Account\nroute to sign-in / account-link-safe path"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5381",
            "text": "Create Account in verification-pending state with stable Account ID"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5384",
            "text": "Create candidate contact as UNVERIFIED"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5387",
            "text": "Send verification challenge through Tunner notification/provider abstraction"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5390",
            "text": "Verification proof valid and unexpired?"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5393",
            "text": "Remain unverified; apply retry/rate-limit/security policy"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5396",
            "text": "Mark contact verified with immutable evidence/version"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5399",
            "text": "Personal Information after verified contact\nDOB + normal profile fields"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5402",
            "text": "Establish baseline security/recovery posture\nAccount becomes ACTIVE or policy-defined restricted/verification state"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5405",
            "text": "After successful registration/authentication: Account Center"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5408",
            "text": "Product Relationship already ACTIVE?"
          },
          {
            "kind": "shape-with-text",
            "id": "78:5411",
