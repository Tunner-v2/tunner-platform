        "id": "88:6720",
        "name": "38 — Identity — Authentication Assurance, Passkeys, MFA &amp; Step-Up",
        "nodes": [
          {
            "kind": "shape-with-text",
            "id": "79:5509",
            "text": "Authentication or sensitive-action challenge begins"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5512",
            "text": "Resolve Account, client/origin, requested action, device context and current session assurance"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5515",
            "text": "Resolve eligible authentication methods\npassword · passkey · federated · authenticator · approved recovery"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5518",
            "text": "Perform primary authentication challenge"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5521",
            "text": "Primary proof valid?"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5524",
            "text": "Reject / rate-limit / security signal according to policy"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5527",
            "text": "Compute resulting assurance level from method + policy + context"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5530",
            "text": "Required assurance satisfied?"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5533",
            "text": "Create/upgrade current authentication context as permitted"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5536",
            "text": "Require MFA / stronger proof"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5539",
            "text": "Use approved second factor or passkey"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5542",
            "text": "Factor proof valid?"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5545",
            "text": "Purpose?"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5548",
            "text": "Create/resume Tunner session with assurance, auth time, device/session refs and expiry"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5551",
            "text": "Create operation-bound Step-Up Evidence\nrequired assurance · method · expiry · operation ID"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5554",
            "text": "Owning domain revalidates authorization, expected versions and step-up before execution"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5557",
            "text": "Enroll new authenticator/passkey/recovery method"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5560",
            "text": "Require current-session reauthentication / step-up as policy requires"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5563",
            "text": "Method type"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5566",
            "text": "WebAuthn registration ceremony\nprivate key never reaches Tunner"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5569",
            "text": "Generate one-time enrollment secret/QR\nverify first TOTP before activation"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5572",
            "text": "Generate server-side one-time recovery code set\nreveal/download once only"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5575",
            "text": "Persist opaque credential/public-key metadata + method version"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5578",
            "text": "Security notification + audit/activity evidence"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5581",
            "text": "Security rules"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5584",
            "text": "Step-up evidence expires and is bound to one operation context"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5587",
            "text": "No Admin or frontend receives passkey private keys, authenticator secrets or recovery-code values after one-time handling"
          },
          {
            "kind": "shape-with-text",
            "id": "79:5590",
            "text": "Method revocation/reset is a separate governed operation; side effects follow explicit policy"
          },
