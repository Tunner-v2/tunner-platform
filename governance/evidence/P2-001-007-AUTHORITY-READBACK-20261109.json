      {
        "id": "88:6714",
        "name": "36 — Identity, Authentication, Sessions &amp; Security — Functional Architecture",
        "nodes": [
          {
            "kind": "shape-with-text",
            "id": "77:5232",
            "text": "Tunner user / Account Center"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5235",
            "text": "Accounts & Identity Authority\nAccount · profile · verified contacts · auth methods · MFA/passkeys · recovery · Account state"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5238",
            "text": "Connected Product"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5241",
            "text": "Tunner Authorization Server\nOAuth/OIDC · registered clients · scopes · PKCE · audience"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5244",
            "text": "Authentication Service\ncredential challenge · assurance · MFA · passkey · recovery checks"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5247",
            "text": "Tunner Session Authority\nsession_id · device_id · assurance · expiry · revocation"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5250",
            "text": "Product Authorization Grant\nProduct/client/scopes bound; not a Product local session"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5253",
            "text": "Connected Product creates/owns its local Product session and onboarding"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5256",
            "text": "Device & Trust Registry\nknown device evidence · trust state · passkey linkage"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5259",
            "text": "Recovery Orchestration\nproof hierarchy · risk gates · controlled restoration"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5262",
            "text": "Identity Verification\nprovider evidence · Tunner verification state · review case"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5265",
            "text": "Security Operations\nsecurity events · investigation · session trace · containment review"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5268",
            "text": "Risk & Compliance\nrisk case · ID verification review · policy exception"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5271",
            "text": "Audit & Governance\napproval · policy version · immutable evidence"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5274",
            "text": "Internal Access\nseparate workforce identity · roles/scopes · privileged sessions"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5277",
            "text": "Account Activity Projection\nsafe user-visible history"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5280",
            "text": "Mandatory security/account notification intents"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5283",
            "text": "Authority boundary"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5286",
            "text": "Tunner Account identity is separate from Product membership/role/context"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5289",
            "text": "Tunner Session is central SSO authority, not a shared Product session cookie"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5292",
            "text": "Security evidence does not replace Account identity state"
          },
          {
            "kind": "shape-with-text",
            "id": "77:5295",
            "text": "Risk/Compliance can gate/review but does not silently rewrite Identity state"
          },
