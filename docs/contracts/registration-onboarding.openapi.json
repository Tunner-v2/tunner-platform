    "/registration/progress": {
      "get": {
        "operationId": "registrationProgress",
        "description": "HTTPS, same-origin read of expiring protected HttpOnly browser pointer, caller/network-bound application FindAsync and current server policy. Contains no code, DOB or credential, and grants no login session. Unknown/expired context fails safely.",
        "responses": {
          "200": {
            "description": "Current completed stage; not an authentication session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "202": {
            "description": "Current authorized onboarding stage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "400": {
            "description": "Not found or not disclosable"
          },
          "403": {
            "description": "Missing/expired/invalid protected browser context"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Required dependency unavailable"
          }
        }
      }
    },
    "/registration/restart": {
      "post": {
        "operationId": "restartRegistrationPresentation",
        "description": "Reset only the protected presentation/idempotency pointer for a new registration attempt. Existing operation/account/evidence is preserved. HTTPS, configured origin, CSRF, valid protected browser context and bounded empty object are mandatory.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tunner-CSRF",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New non-authorizing browser-bound attempt key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "registrationKey"
                  ],
                  "properties": {
                    "registrationKey": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed object or missing CSRF"
          },
          "403": {
            "description": "Origin or browser context rejected"
          },
          "413": {
            "description": "256-byte budget exceeded"
          },
          "415": {
            "description": "JSON required"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idempotencyKey",
          "email",
          "password",
          "passwordConfirmation",
          "termsVersion",
          "privacyVersion",
          "acknowledgedNotices"
        ],
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "passwordConfirmation": {
            "type": "string",
            "writeOnly": true
          },
          "termsVersion": {
            "type": "string"
          },
          "privacyVersion": {
            "type": "string"
          },
          "acknowledgedNotices": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "CompletePersonalInformation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "idempotencyKey",
          "expectedVersion",
          "dateOfBirth"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "writeOnly": true,
            "description": "RESTRICTED_PERSONAL. Required only after verified contact in normal Personal Information; never an Account age admission gate."
          },
          "fullName": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          }
        }
      },
      "VersionedOperation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "idempotencyKey",
          "expectedVersion"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "VerifyContact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "idempotencyKey",
          "expectedVersion",
          "code"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "OperationResult": {
        "type": "object",
        "required": [
          "operationId",
          "correlationId",
          "status",
          "version",
          "nextAction"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "REQUIRES_ACTION",
              "SUCCEEDED"
            ]
          },
          "version": {
            "type": "integer"
          },
          "nextAction": {
            "enum": [
              "VERIFY_CONTACT",
              "PERSONAL_INFORMATION",
              "CONSENT_REQUIRED",
              "COMPLETE"
            ]
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "resendAfter": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Disclosed only to verified, bound onboarding context."
          },
          "ageCapabilities": {
            "type": [
              "object",
              "null"
            ],
            "description": "Safe current age/consent policy evaluation; independentCommercialEligible is an age capability, never a BillingAuthority grant. No DOB."
          },
          "personalInformation": {
            "type": [
              "object",
              "null"
            ],
            "description": "Verified email and server field limits; raw DOB and saved names are never projected by this onboarding interface."
          }
        }
      }
    }
  },
  "x-tunner-screen-paths": [
    "/registration",
    "/registration/verify-email",
    "/registration/personal-information",
    "/registration/consent",
    "/registration/complete"
  ],
  "x-tunner-bootstrap-attempt-key": "GET /registration/options returns registrationKey for the protected attempt pointer; initial real clients retain it in memory. It is not an authentication or verification proof. Existing arbitrary idempotency keys remain accepted and update only that protected pointer on successful registration."
}
