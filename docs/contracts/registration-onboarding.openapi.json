{
  "openapi": "3.1.0",
  "info": {
    "title": "Tunner private User BFF registration/onboarding contract",
    "version": "pdr0011-onboarding-v1",
    "description": "Implementation schema under Doc32. No public SDK/product API activation or legal/content publication. Historical PDR-0007 receipts remain historical."
  },
  "paths": {
    "/registration/register": {
      "post": {
        "operationId": "register",
        "description": "HTTPS and configured same-origin request, framework antiforgery, expiring protected browser context and server abuse/policy checks. No login session. Unknown client claims are rejected.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tunner-CSRF",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccount"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed or replayed operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "202": {
            "description": "Next action required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "400": {
            "description": "Safe validation/proof/context problem; no raw request values"
          },
          "409": {
            "description": "VERSION_CONFLICT"
          },
          "413": {
            "description": "Bounded body exceeded"
          },
          "429": {
            "description": "RATE_OR_ABUSE_LIMITED"
          },
          "503": {
            "description": "Explicit policy/provider dependency unavailable"
          }
        }
      }
    },
