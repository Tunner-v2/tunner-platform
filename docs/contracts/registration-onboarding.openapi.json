  "components": {
    "schemas": {
      "RegisterAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idempotencyKey",
          "email",
          "password",
          "passwordConfirmation",
          "termsVersion",
          "privacyVersion",
          "acknowledgedNotices"
        ],
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "passwordConfirmation": {
            "type": "string",
            "writeOnly": true
          },
          "termsVersion": {
            "type": "string"
          },
          "privacyVersion": {
            "type": "string"
          },
          "acknowledgedNotices": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "CompletePersonalInformation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "idempotencyKey",
          "expectedVersion",
          "dateOfBirth"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "writeOnly": true,
            "description": "RESTRICTED_PERSONAL. Required only after verified contact in normal Personal Information; never an Account age admission gate."
          },
          "fullName": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          }
        }
      },
      "VersionedOperation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "idempotencyKey",
          "expectedVersion"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "VerifyContact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "idempotencyKey",
          "expectedVersion",
          "code"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "OperationResult": {
        "type": "object",
        "required": [
          "operationId",
          "correlationId",
          "status",
          "version",
          "nextAction"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "REQUIRES_ACTION",
              "SUCCEEDED"
            ]
          },
          "version": {
            "type": "integer"
          },
          "nextAction": {
            "enum": [
              "VERIFY_CONTACT",
              "PERSONAL_INFORMATION",
              "CONSENT_REQUIRED",
              "COMPLETE"
            ]
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "resendAfter": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Disclosed only to verified, bound onboarding context."
          },
          "ageCapabilities": {
            "type": [
              "object",
              "null"
            ],
            "description": "Safe current age/consent policy evaluation; independentCommercialEligible is an age capability, never a BillingAuthority grant. No DOB."
          },
          "personalInformation": {
            "type": [
              "object",
              "null"
            ],
            "description": "Verified email and server field limits; raw DOB and saved names are never projected by this onboarding interface."
          }
        }
      }
    }
  }
}
